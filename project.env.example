# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=api.agromega.in.ua
CSRF_TRUSTED_ORIGINS=https://api.agromega.in.ua

# Existing PostgreSQL database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bugagadb
POSTGRES_USER=bugaga
POSTGRES_PASSWORD=replace-me

# AgroMega OpenID Connect provider
OIDC_ISSUER=https://agromega.in.ua/o
OIDC_CLIENT_ID=agromega-parser
OIDC_CLIENT_SECRET=replace-with-the-registered-client-secret
OIDC_CALLBACK_URL=https://api.agromega.in.ua/oidc/callback/
OIDC_POST_LOGOUT_REDIRECT_URL=https://api.agromega.in.ua/admin/
OIDC_SCOPES=openid profile email
OIDC_SYNC_SUPERUSER=false

# Celery-managed replacements for the legacy bot and scheduler.
# Keep both false until each corresponding legacy process has stopped.
BUGAGA_BOT_ENABLED=false
BUGAGA_SCHEDULER_ENABLED=false
TELEGRAM_TOKEN=replace-with-telegram-bot-token
TELEGRAM_POLL_TIMEOUT=2
TELEGRAM_POLL_INTERVAL_SECONDS=5
SCHEDULER_INTERVAL=30
BUGAGA_SUMMARY_TIME_ZONE=Europe/Kyiv
CELERY_BROKER_URL=redis://redis:6379/0

# Daily summary and DigitalOcean Spaces image mirroring
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_SUMMARY_MODEL=gpt-4o
DO_SPACE_KEY=replace-me
DO_SPACE_SECRET=replace-me
DO_SPACE_REGION=fra1
DO_SPACE_NAME=replace-me
