# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=api.agromega.in.ua
CSRF_TRUSTED_ORIGINS=https://api.agromega.in.ua

# Existing PostgreSQL database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bugagadb
POSTGRES_USER=bugaga
POSTGRES_PASSWORD=replace-me

# AgroMega OpenID Connect provider
OIDC_ISSUER=https://agromega.in.ua/o
OIDC_CLIENT_ID=agromega-parser
OIDC_CLIENT_SECRET=replace-with-the-registered-client-secret
OIDC_CALLBACK_URL=https://api.agromega.in.ua/oidc/callback/
OIDC_POST_LOGOUT_REDIRECT_URL=https://api.agromega.in.ua/admin/
OIDC_SCOPES=openid profile email
OIDC_SYNC_SUPERUSER=false

